<!DOCTYPE html>
<html lang="es-GT">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Nexus | Proservicios Guatemala</title>
<meta name="description" content="Nexus - placas digitales NFC y QR para negocios. Proservicios Guatemala.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;700;800&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --blue-bright:#0F64FF;
    --blue-main:#0E4BC4;
    --blue-dark:#0A2E7A;
    --ink:#0A1F44;
    --bg-top:#F3F6FF;
    --bg-bottom:#FFFFFF;
    --muted:#5B6B8C;
    --white:#FFFFFF;
    --radius-lg:24px;
    --radius-md:16px;
    --shadow: 0 14px 30px rgba(10,46,122,0.14);
  }

  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    font-family:'Inter', sans-serif;
    color:var(--ink);
    min-height:100vh;
    background: linear-gradient(180deg, var(--bg-top) 0%, var(--bg-bottom) 55%);
    -webkit-font-smoothing:antialiased;
  }

  .wrap{
    max-width:440px;
    margin:0 auto;
    padding:40px 22px 34px;
    min-height:100vh;
    display:flex;
    flex-direction:column;
  }

  /* subtle tech grid accent, single deliberate motif */
  .grid-accent{
    position:absolute;
    top:0; left:0; right:0;
    height:280px;
    background-image: radial-gradient(circle at 1px 1px, rgba(14,75,196,0.10) 1px, transparent 0);
    background-size: 26px 26px;
    mask-image: linear-gradient(180deg, black, transparent);
    -webkit-mask-image: linear-gradient(180deg, black, transparent);
    z-index:0;
    pointer-events:none;
  }

  header{
    text-align:center;
    position:relative;
    z-index:1;
    margin-top:4px;
  }

  .logo-plate{
    width:132px;
    height:132px;
    margin:0 auto 20px;
    border-radius:32px;
    background:var(--white);
    box-shadow: var(--shadow);
    display:flex;
    align-items:center;
    justify-content:center;
    padding:20px;
  }
  .logo-plate img{
    width:100%;
    height:100%;
    object-fit:contain;
  }

  .brand{
    font-family:'Manrope', sans-serif;
    font-weight:800;
    font-size:2.1rem;
    letter-spacing:-0.02em;
    color:var(--ink);
    margin:0 0 4px;
  }

  .legal{
    font-family:'Manrope', sans-serif;
    font-weight:700;
    font-size:0.72rem;
    letter-spacing:0.14em;
    color:var(--blue-main);
    text-transform:uppercase;
    margin:0 0 18px;
  }

  .pitch{
    font-size:1rem;
    color:var(--muted);
    line-height:1.55;
    margin:0 0 6px;
    padding:0 6px;
  }

  .price-chip{
    display:inline-flex;
    align-items:center;
    gap:6px;
    margin:14px auto 28px;
    padding:8px 16px;
    border-radius:999px;
    background:rgba(15,100,255,0.08);
    border:1px solid rgba(15,100,255,0.18);
    color:var(--blue-main);
    font-weight:700;
    font-size:0.82rem;
  }

  /* how it works - 3 compact steps */
  .how{
    display:flex;
    justify-content:space-between;
    gap:8px;
    margin:0 0 30px;
    position:relative;
    z-index:1;
  }
  .how-step{
    flex:1;
    text-align:center;
    padding:14px 6px;
    background:var(--white);
    border-radius:var(--radius-md);
    box-shadow: 0 6px 16px rgba(10,46,122,0.08);
  }
  .how-step .num{
    width:24px;height:24px;
    margin:0 auto 8px;
    border-radius:50%;
    background:var(--blue-main);
    color:var(--white);
    font-family:'Manrope', sans-serif;
    font-weight:800;
    font-size:0.78rem;
    display:flex;align-items:center;justify-content:center;
  }
  .how-step p{
    margin:0;
    font-size:0.72rem;
    color:var(--muted);
    line-height:1.35;
    font-weight:600;
  }

  main{
    display:flex;
    flex-direction:column;
    gap:14px;
    position:relative;
    z-index:1;
  }

  .btn{
    display:flex;
    align-items:center;
    gap:14px;
    width:100%;
    padding:17px 20px;
    border-radius:var(--radius-lg);
    text-decoration:none;
    font-family:'Manrope', sans-serif;
    font-weight:700;
    font-size:1rem;
    min-height:60px;
    border:none;
    cursor:pointer;
    transition:transform 0.15s ease;
    -webkit-tap-highlight-color:transparent;
  }
  .btn:active{transform:scale(0.97);}
  .btn:focus-visible{outline:3px solid var(--blue-dark); outline-offset:3px;}

  .btn .icon{
    width:24px;height:24px;flex:0 0 24px;
    display:flex;align-items:center;justify-content:center;
  }
  .btn .icon svg{width:100%;height:100%;}
  .btn .label{flex:1;text-align:left;}
  .btn .chev svg{width:16px;height:16px;}

  .btn-primary{
    background: linear-gradient(135deg, var(--blue-bright), var(--blue-main));
    color:var(--white);
    box-shadow: 0 14px 24px rgba(15,100,255,0.32);
  }
  .btn-primary .chev{color:rgba(255,255,255,0.85);}

  .btn-secondary{
    background:var(--white);
    color:var(--ink);
    border:2px solid rgba(10,46,122,0.12);
    box-shadow: 0 8px 16px rgba(10,46,122,0.06);
  }
  .btn-secondary .chev{color:var(--blue-main);}
  .btn-secondary .icon{color:var(--blue-main);}

  footer{
    margin-top:auto;
    padding-top:34px;
    text-align:center;
    position:relative;
    z-index:1;
  }
  .footer-legal{
    font-size:0.74rem;
    color:var(--muted);
    line-height:1.6;
  }
  .footer-legal strong{color:var(--ink);}
</style>
</head>
<body>
<div class="grid-accent" aria-hidden="true"></div>
<div class="wrap">

  <header>
    <div class="logo-plate">
      <img src="data:image/webp;base64," alt="Nexus" width="480" height="480">
    </div>
    <p class="brand">Nexus</p>
    <p class="legal">Proservicios Guatemala</p>
    <p class="pitch">Placas digitales NFC + QR para tu negocio.<br>Sin apps. Sin mensualidades.</p>
    <span class="price-chip">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H7"/></svg>
      Placas desde Q299
    </span>
  </header>

  <div class="how">
    <div class="how-step">
      <div class="num">1</div>
      <p>Acercas tu placa NFC al celular</p>
    </div>
    <div class="how-step">
      <div class="num">2</div>
